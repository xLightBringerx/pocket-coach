@baseUrl = http://localhost:4000/api

### 1. Log in as the test client
# @name client
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "client@test.com", "password": "password123" }

### 2. Current plan (we log against its week)
# @name plan
GET {{baseUrl}}/plans/current
Authorization: Bearer {{client.response.body.$.token}}

### 3. Tick off an exercise (expect 201)
POST {{baseUrl}}/logs/workout
Authorization: Bearer {{client.response.body.$.token}}
Content-Type: application/json

{ "date": "{{plan.response.body.$.plan.weekStart}}", "exerciseId": "goblet-squat" }

### 4. Same exercise again (expect 201, same _id as test 3, no duplicate)
POST {{baseUrl}}/logs/workout
Authorization: Bearer {{client.response.body.$.token}}
Content-Type: application/json

{ "date": "{{plan.response.body.$.plan.weekStart}}", "exerciseId": "goblet-squat" }

### 5. Unknown exercise (expect 400)
POST {{baseUrl}}/logs/workout
Authorization: Bearer {{client.response.body.$.token}}
Content-Type: application/json

{ "date": "{{plan.response.body.$.plan.weekStart}}", "exerciseId": "moon-jump" }

### 6. Log a meal (expect 201)
# @name meal
POST {{baseUrl}}/logs/meal
Authorization: Bearer {{client.response.body.$.token}}
Content-Type: application/json

{ "date": "{{plan.response.body.$.plan.weekStart}}", "mealName": "Chicken and rice", "calories": 650, "proteinG": 45, "carbsG": 70, "fatG": 15 }

### 7. Meal without a name (expect 400)
POST {{baseUrl}}/logs/meal
Authorization: Bearer {{client.response.body.$.token}}
Content-Type: application/json

{ "date": "{{plan.response.body.$.plan.weekStart}}", "calories": 300 }

### 8. This week's logs (expect 200, 2 entries)
GET {{baseUrl}}/logs?weekStart={{plan.response.body.$.plan.weekStart}}
Authorization: Bearer {{client.response.body.$.token}}

### 9. Run the AI check-in (expect 200, plan.checkIn with numbers, summary and adjustments)
POST {{baseUrl}}/plans/check-in
Authorization: Bearer {{client.response.body.$.token}}

### 10. Check in again right away (expect 429)
POST {{baseUrl}}/plans/check-in
Authorization: Bearer {{client.response.body.$.token}}

### 11. Delete the meal (expect 200)
DELETE {{baseUrl}}/logs/{{meal.response.body.$.log._id}}
Authorization: Bearer {{client.response.body.$.token}}

### 12. Delete it again (expect 404)
DELETE {{baseUrl}}/logs/{{meal.response.body.$.log._id}}
Authorization: Bearer {{client.response.body.$.token}}

### 13. Log in as a trainer
# @name jordan
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "jordan@pocketcoach.test", "password": "password123" }

### 14. Trainer tries to read logs (expect 403)
GET {{baseUrl}}/logs?weekStart=2026-11-09
Authorization: Bearer {{jordan.response.body.$.token}}